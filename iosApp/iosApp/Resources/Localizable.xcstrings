    "source_management.help_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持 legado 风格的导入、筛选、排序、单源编辑和批量操作。搜索框也支持启用、禁用、需登录、无分组、启用探索、禁用探索以及 group:分组名。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import, filter, sort, edit, or manage sources in batch. Search filters: 启用 (enabled), 禁用 (disabled), 需登录 (login required), 无分组 (ungrouped), 启用探索 (Discovery on), 禁用探索 (Discovery off), or group:name."
          }
        }
      }
    },
