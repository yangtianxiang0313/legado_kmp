    "backup.notice.restore_metadata_invalid": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KMP metadata 不匹配、损坏或密码不正确；已忽略扩展快照，仅使用 Android 原生文件恢复。"
          }
        },
        "en": {
          "stringUnit": {
