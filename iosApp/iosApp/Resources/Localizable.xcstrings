    "backup.notice.restore_servers_not_restored": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器配置未恢复：备份密码不正确或加密数据已损坏。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server settings were not restored: the backup password is incorrect or the encrypted data is damaged."
          }
        }
      }
    },
    "backup.notice.restore_webdav_password_not_restored": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV 密码未恢复：备份密码不正确或密码数据未加密，请重新填写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WebDAV password was not restored: the backup password is incorrect or the password data is not encrypted. Enter it again."
          }
        }
      }
    },
    "backup.notice.restore_metadata_unreadable": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KMP metadata 无法读取；已忽略扩展快照，仅使用 Android 原生文件恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KMP metadata could not be read. The extended snapshot was ignored; only native Android files are used for restoration."
          }
        }
      }
    },
    "backup.notice.restore_fonts_backgrounds_missing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 自定义字体和背景图片文件未包含在备份中，已使用系统字体与默认背景；需要在 iOS 重新选择。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android custom font and background image files are not included in the backup. System fonts and default backgrounds are used; select them again on iOS."
          }
        }
      }
    },
    "backup.notice.restore_local_books_records_only": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地书籍仅恢复书架记录，Android 本地文件路径不会迁移；请重新导入原书文件，或在忽略项中跳过本地书籍。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only bookshelf records are restored for local books; Android local file paths are not migrated. Import the original book files again, or skip local books in the exclusion options."
          }
        }
      }
    },
    "backup.notice.export_partial_encryption": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 备份不是整体加密：仅服务器列表与 WebDAV 密码按原生 BackupAES 加密，书源请求头、规则和变量仍为明文。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android backups are not encrypted as a whole: only the server list and WebDAV password are encrypted with native BackupAES. Book source request headers, rules, and variables remain in plain text."
          }
        }
      }
    },
    "backup.notice.export_metadata_android_ignored": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KMP 扩展快照另存为 metadata；Android 不使用此文件，Android 重新备份后不会保留这些扩展。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The KMP extended snapshot is saved separately as metadata. Android does not use this file and will not retain these extensions when creating a new backup."
          }
        }
      }
    },
    "backup.notice.export_external_resources_excluded": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP 不包含本地书原文件、字体、背景、封面或欢迎页图片，也不包含正文、Cookie 和独立脚本大变量缓存；资源需在目标设备另行导入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ZIP excludes original local book files, fonts, backgrounds, cover and welcome-screen images, book text, cookies, and large-variable caches for standalone scripts. Import resources separately on the target device."
          }
        }
      }
    },
    "backup.notice.export_local_books_records_only": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地书仅导出书架记录和进度，不包含原书文件；Android 本地路径不可迁移，需重新导入原书。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only bookshelf records and progress are exported for local books, not the original files. Android local paths cannot be migrated; import the original books again."
          }
        }
      }
    },
    "backup.notice.export_local_covers_references_only": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地封面图片文件未迁移，书架和分组仅保留原封面引用；目标设备需重新选择图片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local cover image files are not migrated. Bookshelf and group records retain only their original cover references; select images again on the target device."
          }
        }
      }
    },
    "backup.notice.export_shared_layout_fallback": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享阅读排版快照无效，Android 备份已回退到原生共享配置或默认排版。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared reader layout snapshot is invalid. The Android backup has fallen back to native shared settings or the default layout."
          }
        }
      }
    },
    "backup.notice.export_direct_link_plaintext": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 原生直链上传规则为明文文件，可能包含上传凭据；请妥善保管备份。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Android direct link upload rules are stored in a plaintext file and may contain upload credentials. Keep the backup secure."
          }
        }
      }
    },
    "backup.notice.export_title_size_rounded": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 标题字号为整数，小数字号已取整；原值保留在 KMP metadata。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android title font sizes are integers, so fractional sizes have been converted to integers. Original values are retained in KMP metadata."
          }
        }
      }
    },
    "backup.notice.export_fonts_not_migrated": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字体文件与 iOS 字体并未迁移；Android 仅保留字体名称或路径引用，需要在目标设备重新选择。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Font files and iOS fonts are not migrated. Android retains only font names or path references; select fonts again on the target device."
          }
        }
      }
    },
    "backup.notice.export_backgrounds_not_migrated": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义阅读背景图片未迁移；Android 原生配置使用纯色背景，原路径保留在 KMP metadata。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom reader background images are not migrated. Native Android settings use solid-color backgrounds; original paths are retained in KMP metadata."
