    "backup.automatic.schedule.footer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距上次成功超过 24 小时后，在解锁或保存阅读进度时尝试；后台仅使用 iOS 提供的有限执行时间，锁定后暂停，不保证每日后台运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attempts backup on unlock or reading progress saves when over 24 hours have passed since the last successful backup. Background work uses only the limited time provided by iOS. Pauses when locked; daily background execution is not guaranteed."
          }
        }
      }
    },
    "backup.automatic.startup.footer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
