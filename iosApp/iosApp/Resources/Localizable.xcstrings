      }
    },
    "reader.help_content_menu" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单：点击屏幕中央区域打开菜单，可调整亮度、字体、翻页动画等。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu: Tap the center of the screen to open the menu and adjust brightness, font, page-turn animation and more."
          }
        }
      }
    },
    "reader.help_content_long_press" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按选字：长按正文可选择文字，进行复制、朗读、替换等操作。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select text: Long-press the body text to select it, then copy, read aloud, replace and more."
          }
        }
      }
    },
    "reader.help_content_brightness" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亮度调节：菜单显示时侧边可拖动亮度条，也可切换自动/手动亮度。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brightness: When the menu is open, drag the slider at the side or switch between automatic and manual brightness."
          }
        }
      }
    },
    "reader.help_content_auto_page" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动翻页：在菜单中开启自动翻页，可调整翻页速度。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto page turning: Enable it in the menu and adjust the page-turn speed."
          }
        }
      }
    },
    "reader.help_content_read_aloud" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朗读：在菜单中开启朗读，支持调整语速、音调和音色。"
          }
