          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoration merges data and overwrites matching records. Restore exclusions apply to settings. The database and settings are saved separately; success across both stores is not guaranteed. Committed data is not rolled back automatically."
          }
        }
      }
