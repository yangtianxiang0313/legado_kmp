        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is a reading tool. When using book sources, feeds, websites or online media, ensure that you have permission to access and use the content and comply with the provider's terms. Importing rules does not grant content rights, and a disclaimer does not replace the necessary authorization."
          }
        }
      }
