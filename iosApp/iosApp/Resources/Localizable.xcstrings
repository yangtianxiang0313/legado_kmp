      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击翻页：点击屏幕左侧翻到上一页，右侧翻到下一页，中央打开菜单。"
          }
        },
        "en" : {
