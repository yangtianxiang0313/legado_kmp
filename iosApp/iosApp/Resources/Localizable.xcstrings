        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Header or footer colors are invalid. Android uses default colors; original values are retained in KMP metadata."
          }
        }
      }
    },
    "backup.notice.export_color_marker_collision": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分颜色与 Android 的跟随正文／默认分隔线标记重合；原颜色保留在 KMP metadata。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some colors coincide with Android markers for following the body text color or using the default divider color. Original colors are retained in KMP metadata."
          }
