    "invalid_value": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The value is outside the allowed range."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入值不在允许范围内"}}}},
    "proxy_system": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "System Proxy, Ignore Source Proxy"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "跟随系统，不使用书源代理"}}}},
    "proxy_custom": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Custom Proxy"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自定义代理"}}}},
    "proxy_rule": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Source or System Proxy"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "跟随书源或系统"}}}},
    "proxy_platform": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "HTTP / SOCKS5. WebView proxying requires iOS 17 or later."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "HTTP / SOCKS5。WebView 代理需要 iOS 17 或更高版本。"}}}},
    "proxy_user": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Proxy username (optional)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "代理账号（可选）"}}}},
    "proxy_password": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Proxy password (optional)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "代理密码（可选）"}}}},
    "invalid_proxy": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Invalid proxy address."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "代理地址无效"}}}},
    "revoke": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Revoke Certificate Exception"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "撤销证书兼容"}}}},
    "certificate_failed": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Source Certificate Validation Failed"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "书源证书校验失败"}}}},
    "compatibility": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Certificate Options"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "证书兼容"}}}},
    "certificate_warning": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Source: %@\nServer: %@:%d\nCertificate SHA-256: %@\n\nThe system cannot verify this server's identity. It may be impersonated. This exception applies only to this source, host and certificate, and expires in 30 days. Other hosts, login, uploads and cloud backups are unaffected."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "书源：%@\n服务器：%@:%d\n证书 SHA-256：%@\n\n此服务器的身份无法通过系统验证，可能存在冒充风险。授权只适用于此书源的这个域名及证书，30 天后过期；其他域名、登录、上传与云备份不受影响。"}}}},
    "allowed": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Exception saved for this host and certificate. Retry the original action."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已允许此域名及证书，请重试原操作"}}}},
    "settings_summary": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Defaults, source overrides and certificate exceptions"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "全局默认、书源覆盖与证书授权"}}}}
  },
  "version": "1.0"
}
