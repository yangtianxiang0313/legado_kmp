    "certificate_scope": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Exceptions match the source, host, port and certificate, and expire in 30 days. Login, uploads and cloud backups still use strict certificate validation."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "授权仅匹配书源、域名、端口及证书，30 天后过期。登录、上传和云备份仍严格校验证书。"}}}},
    "timeout": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Request Timeout"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请求超时"}}}},
    "retry": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Retry Count"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重试次数"}}}},
    "concurrent": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Concurrent Requests per Source"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "单书源并发数"}}}},
    "agent": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "User-Agent"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "User-Agent"}}}},
    "proxy": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Proxy"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "代理"}}}},
