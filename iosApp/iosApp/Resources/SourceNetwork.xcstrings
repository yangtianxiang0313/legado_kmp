  "sourceLanguage": "zh-Hans",
  "strings": {
    "title": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Source Network Settings"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "书源网络设置"}}}},
    "defaults": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Defaults for All Sources"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "全局书源默认值"}}}},
    "overrides": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Overrides for This Source"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此书源覆盖设置"}}}},
