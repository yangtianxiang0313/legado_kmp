    "source_agent": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Source or app default"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用书源或应用默认值"}}}},
    "choose_source": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Per-Source Settings"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "按书源设置"}}}},
    "allow_action": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Allow Certificate Exception for This Source"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "允许此书源证书兼容"}}}},
    "strict_default": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No exceptions. Strict validation."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未授权，严格校验证书"}}}},
    "expires": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Expires: "}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "到期："}}}},
    "reset_defaults": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reset Global Defaults"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复全局默认值"}}}},
    "reset_source": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Clear Source Overrides and Certificate Exceptions"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "清除此书源覆盖与证书授权"}}}},
    "inherit": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use Default"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "跟随默认"}}}},
